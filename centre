#!/bin/bash
# Centre — build, run and install. Needs only the Xcode Command Line Tools (clang).
#
#   ./centre            build if Sources/ changed, then open Centre
#   ./centre build      force a rebuild (the build is signed and self-tested before it replaces the old one)
#   ./centre release    build Centre-<VERSION>.dmg (to install) and .zip (for in-app updates) into dist/
#   ./centre install    build, then install into /Applications and open it there
#   ./centre restart    relaunch now      ./centre stop      quit
#   ./centre test       self-test         ./centre status    build, signature and install details
#   ./centre shots      README screenshots into docs/      ./centre snap   every design snapshot into .agent/snaps/
#   ./centre log | crash | trace          recent log lines, newest crash report, Centre's lifecycle log
#
# The build agent (a LaunchAgent this script installs) runs any of these without Terminal: put a file named
# <id>.job containing the command into .agent/inbox; output lands in .agent/out/<id>.log, exit code in <id>.exit.
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
APP="$DIR/Centre.app"
BIN="$APP/Contents/MacOS/Centre"
SRCDIR="$DIR/Sources"
DEST="/Applications/Centre.app"
AGENT="$DIR/.agent"
TRACE="$HOME/Library/Logs/Centre/trace.log"
APPRE='Centre\.app/Contents/MacOS/Centre$'   # the app itself; agent, self-test and render runs carry arguments
SIGN_NAME="Centre Local Signing"
VERSION="$(tr -d ' \n' < "$DIR/VERSION" 2>/dev/null || echo 1.0.0)"   # bump this file to release
LSREG=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
mkdir -p "$AGENT/inbox" "$AGENT/out"

# The copy you use: the installed one once it exists, otherwise the build here.
run_app() { if [ -d "$DEST" ]; then echo "$DEST"; else echo "$APP"; fi; }

limited() {   # run with a time limit: renders and self-tests must never hang a job
  local secs=$1; shift
  "$@" & local p=$!
  for i in $(seq 1 $((secs * 10))); do kill -0 $p 2>/dev/null || break; sleep 0.1; done
  if kill -0 $p 2>/dev/null; then kill -9 $p 2>/dev/null; echo "Timed out after ${secs}s"; return 124; fi
  wait $p
}

quit_centre() {   # a normal quit first, so Centre puts the Dock back; force only if it hangs
  pkill -TERM -f "$APPRE" 2>/dev/null || true
  for i in $(seq 1 50); do pgrep -f "$APPRE" >/dev/null || return 0; sleep 0.1; done
  pkill -9 -f "$APPRE" 2>/dev/null || true
}

# The build agent is the Centre binary in --agent mode, so it works under Centre's own permissions.
install_agent() {
  local label=com.y.centre.agent pl="$HOME/Library/LaunchAgents/com.y.centre.agent.plist" want
  mkdir -p "$HOME/Library/LaunchAgents"
  want=$(cat <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>$BIN</string><string>--agent</string><string>$DIR</string></array>
  <key>QueueDirectories</key><array><string>$AGENT/inbox</string></array>
  <key>StartInterval</key><integer>8</integer>
  <key>StandardOutPath</key><string>$AGENT/agent.log</string>
  <key>StandardErrorPath</key><string>$AGENT/agent.log</string>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
</dict></plist>
PL
)
  if [ "$(cat "$pl" 2>/dev/null)" != "$want" ]; then
    printf '%s\n' "$want" > "$pl"
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  fi
  launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1 || launchctl bootstrap "gui/$(id -u)" "$pl" >/dev/null 2>&1 || true
}

case "$1" in
  stop) quit_centre; echo "Centre stopped"; exit 0 ;;
  log) log show --predicate 'process == "Centre"' --last 10m --style compact 2>/dev/null | tail -60; exit 0 ;;
  crash) f=$(ls -t "$HOME/Library/Logs/DiagnosticReports"/Centre*.ips 2>/dev/null | head -1)
         if [ -z "$f" ]; then echo "No crash reports"; else echo "$f"; head -c 12000 "$f"; fi; exit 0 ;;
  trace) tail -40 "$TRACE" 2>/dev/null || echo "No trace yet"; exit 0 ;;
  agent-install) install_agent; echo "Agent installed"; exit 0 ;;
esac

stale() { [ ! -x "$BIN" ] || [ -n "$(find "$SRCDIR" \( -name '*.m' -o -name '*.h' \) -newer "$BIN" 2>/dev/null | head -1)" ]; }

# One build at a time (Centre's own file watcher and the agent can both ask). A lock older than 5 minutes is stale.
LOCK="$AGENT/build.lock"
for i in $(seq 1 900); do
  mkdir "$LOCK" 2>/dev/null && break
  [ -n "$(find "$LOCK" -maxdepth 0 -mmin +5 2>/dev/null)" ] && rmdir "$LOCK" 2>/dev/null
  sleep 0.2
done
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

# A release must carry the version in VERSION, so a mismatch forces a fresh build.
built_version() { defaults read "$APP/Contents/Info" CFBundleShortVersionString 2>/dev/null; }
if [ "$1" = "build" ] || stale || { [ "$1" = "release" ] && [ "$(built_version)" != "$VERSION" ]; }; then
  # Signing identity first: a build without it would get a new identity and lose every permission.
  SIGN_ID=$(security find-identity -v -p codesigning 2>/dev/null | awk -v n="\"$SIGN_NAME\"" 'index($0, n) {print $2; exit}')
  if [ -z "$SIGN_ID" ]; then
    echo "No \"$SIGN_NAME\" certificate — run setup-signing.sh (Settings › System) first. Keeping the current build." | tee "$DIR/build.log"
    exit 1
  fi
  echo "Compiling Centre…"
  set -o pipefail
  clang -fobjc-arc -O2 -Wall -Wno-deprecated-declarations -Wno-multichar -Wno-unused-variable \
    -framework Cocoa -framework Carbon -framework ApplicationServices -framework QuartzCore -framework Security \
    -framework ServiceManagement -framework IOKit -framework CoreServices -framework CoreAudio -framework AudioToolbox \
    -I"$SRCDIR" "$SRCDIR"/*.m -o "$BIN.new" 2>&1 | tee "$DIR/build.log"
  set +o pipefail

  # The new build must pass its own checks before it replaces the working app.
  if ! limited 10 "$BIN.new" --selftest >> "$DIR/build.log" 2>&1; then
    echo "Self-test failed — keeping the previous build" | tee -a "$DIR/build.log"; rm -f "$BIN.new"; exit 1
  fi

  # Assemble the bundle. Everything inside it is written before signing and never touched afterwards,
  # because any change to a signed bundle breaks its signature (and macOS then drops its permissions).
  # It is built as a fresh bundle next to the old one and swapped in only once it is signed and verified.
  BUILD_NO=$(git -C "$DIR" rev-list --count HEAD 2>/dev/null || echo 1)
  STAGE="$DIR/.agent/Centre.app"
  rm -rf "$STAGE"; mkdir -p "$STAGE/Contents/MacOS" "$STAGE/Contents/Resources"
  mv -f "$BIN.new" "$STAGE/Contents/MacOS/Centre"
  cat > "$STAGE/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>Centre</string>
  <key>CFBundleDisplayName</key><string>Centre</string>
  <key>CFBundleIdentifier</key><string>com.y.centre</string>
  <key>CFBundleExecutable</key><string>Centre</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$BUILD_NO</string>
  <key>CFBundleIconFile</key><string>Centre</string>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>Centre runs system commands, reads your open browser tabs and controls music through the apps you use.</string>
  <key>NSCalendarsUsageDescription</key><string>Centre shows your next event in its status line and glance.</string>
  <key>NSCalendarsFullAccessUsageDescription</key><string>Centre shows your next event in its status line and glance.</string>
  <key>NSHumanReadableCopyright</key><string>© 2026 Yyas99. Built with Claude.</string>
</dict></plist>
PLIST
  [ -f "$DIR/Centre.icns" ] && cp -f "$DIR/Centre.icns" "$STAGE/Contents/Resources/Centre.icns"

  xattr -cr "$STAGE" 2>/dev/null || true   # Finder info and quarantine flags make codesign refuse the bundle
  # Never fall back to an unsigned or ad-hoc build: that is a new identity, and macOS would ask for everything again.
  if ! codesign -s "$SIGN_ID" -f --identifier com.y.centre --timestamp=none "$STAGE" >>"$DIR/build.log" 2>&1 \
     || ! codesign --verify --strict "$STAGE" >>"$DIR/build.log" 2>&1; then
    echo "Signing failed — keeping the previous build" | tee -a "$DIR/build.log"; rm -rf "$STAGE"; exit 1
  fi
  rm -rf "$APP.old"; [ -d "$APP" ] && mv "$APP" "$APP.old"
  mv "$STAGE" "$APP"; rm -rf "$APP.old"
  [ -x "$LSREG" ] && "$LSREG" -f "$APP" >/dev/null 2>&1 || true
  echo "Built $APP ($VERSION, build $BUILD_NO)"
else
  echo "Up to date"
fi
rmdir "$LOCK" 2>/dev/null || true
install_agent

case "$1" in
  test) limited 20 "$BIN" --selftest; exit $? ;;
  shots) rm -rf "$AGENT/shots"; limited 90 "$BIN" --readme "$AGENT/shots" >/dev/null 2>&1 || true
         n=$(ls "$AGENT/shots"/*.png 2>/dev/null | wc -l | tr -d ' ')
         [ "$n" -gt 0 ] || { echo "No screenshots rendered"; exit 1; }
         # Keep docs/ to exactly what the README shows (plus the icon and the disk image background).
         used=0
         for f in "$AGENT/shots"/*.png; do b=$(basename "$f"); grep -q "docs/$b" "$DIR/README.md" && { cp -f "$f" "$DIR/docs/"; used=$((used+1)); }; done
         for f in "$DIR/docs"/*.png; do b=$(basename "$f"); case "$b" in icon.png|dmg-background*) continue ;; esac
           grep -q "docs/$b" "$DIR/README.md" || rm -f "$f"; done
         echo "Rendered $n screenshots; $used are on the README page"
         exit 0 ;;
  snap) rm -rf "$AGENT/snaps"; limited 120 "$BIN" --snapshot "$AGENT/snaps" >/dev/null 2>&1 || true
        echo "$(ls "$AGENT/snaps" 2>/dev/null | wc -l | tr -d ' ') snapshots in .agent/snaps"; exit 0 ;;
  status)
    if pgrep -f "$APPRE" >/dev/null; then echo "Running: $(ps -o args= -p "$(pgrep -f "$APPRE" | head -1)")"; else echo "Running: no"; fi
    echo "Build here: $(defaults read "$APP/Contents/Info" CFBundleVersion 2>/dev/null) · $(stat -f '%Sm' "$BIN" 2>/dev/null) · sources newer: $(stale && echo yes || echo no)"
    [ -d "$DEST" ] && echo "Installed: $(defaults read "$DEST/Contents/Info" CFBundleShortVersionString 2>/dev/null) build $(defaults read "$DEST/Contents/Info" CFBundleVersion 2>/dev/null)"
    for a in "$APP" "$DEST"; do [ -d "$a" ] || continue
      echo "--- $a"; codesign -dv "$a" 2>&1 | grep -E 'Authority|Identifier='; codesign --verify --strict "$a" 2>&1 && echo "signature valid"
    done
    echo "--- last build"; tail -3 "$DIR/build.log" 2>/dev/null
    echo "--- gh"; for g in gh /opt/homebrew/bin/gh /usr/local/bin/gh; do command -v $g >/dev/null 2>&1 && { $g --version | head -1; $g auth status 2>&1 | head -3; break; }; done
    exit 0 ;;
  release)
    OUT="$DIR/dist"; rm -rf "$OUT"; mkdir -p "$OUT"
    ditto -c -k --keepParent "$APP" "$OUT/Centre-$VERSION.zip"          # what the in-app updater downloads
    S="$AGENT/dmg"; RW="$AGENT/rw.dmg"; rm -rf "$S" "$RW"; mkdir -p "$S/.background"
    ditto "$APP" "$S/Centre.app"; ln -s /Applications "$S/Applications"
    if [ -f "$DIR/docs/dmg-background@2x.png" ] && command -v tiffutil >/dev/null; then
      tiffutil -cathidpicheck "$DIR/docs/dmg-background.png" "$DIR/docs/dmg-background@2x.png" -out "$S/.background/bg.tiff" >/dev/null 2>&1 || true
    fi
    hdiutil detach "/Volumes/Centre" -force >/dev/null 2>&1 || true
    hdiutil create -volname Centre -srcfolder "$S" -fs HFS+ -format UDRW -ov "$RW" >/dev/null
    MNT=$(hdiutil attach -readwrite -noverify -noautoopen "$RW" | awk -F'\t' '/\/Volumes\//{print $NF; exit}')
    # Finder window layout: icon view, the app on the left, Applications on the right, the arrow behind them.
    cat > "$AGENT/layout.applescript" <<'OSA'
tell application "Finder"
  tell disk "Centre"
    open
    set current view of container window to icon view
    set toolbar visible of container window to false
    set statusbar visible of container window to false
    set the bounds of container window to {200, 120, 840, 548}
    set opts to the icon view options of container window
    set arrangement of opts to not arranged
    set icon size of opts to 112
    set text size of opts to 13
    try
      set background picture of opts to file ".background:bg.tiff"
    end try
    set position of item "Centre.app" of container window to {170, 190}
    set position of item "Applications" of container window to {470, 190}
    close
    open
    delay 1
    close
  end tell
end tell
OSA
    limited 25 osascript "$AGENT/layout.applescript" >/dev/null 2>&1 || echo "Window layout skipped (Finder didn't answer); the disk image still works"
    rm -f "$AGENT/layout.applescript"
    sync; hdiutil detach "$MNT" >/dev/null 2>&1 || hdiutil detach "$MNT" -force >/dev/null
    hdiutil convert "$RW" -format UDZO -imagekey zlib-level=9 -o "$OUT/Centre-$VERSION.dmg" >/dev/null
    rm -rf "$S" "$RW"
    codesign -s "$(security find-identity -v -p codesigning 2>/dev/null | awk -v n="\"$SIGN_NAME\"" 'index($0, n) {print $2; exit}')" --timestamp=none "$OUT/Centre-$VERSION.dmg" >/dev/null 2>&1 || true
    (cd "$OUT" && shasum -a 256 Centre-* > SHA256.txt)
    echo "Release $VERSION (build $(defaults read "$APP/Contents/Info" CFBundleVersion 2>/dev/null)) ready in dist/:"; ls -lh "$OUT" | awk 'NR>1 {print "  " $NF "  " $5}'
    # Publish: with the GitHub CLI signed in, straight away; otherwise open a pre-filled release page and the files.
    GH=$(command -v gh || ls /opt/homebrew/bin/gh /usr/local/bin/gh 2>/dev/null | head -1 || true)
    if [ -n "$GH" ] && "$GH" auth status >/dev/null 2>&1; then
      "$GH" release create "v$VERSION" "$OUT/Centre-$VERSION.dmg" "$OUT/Centre-$VERSION.zip" -R Yyas99/Centre --title "Centre $VERSION" --notes-file "$DIR/NOTES" 2>&1 || true
    elif [ -z "$CENTRE_NO_OPEN" ]; then
      NOTES_Q=$(python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(open(sys.argv[1]).read()))' "$DIR/NOTES" 2>/dev/null || echo "")
      open "https://github.com/Yyas99/Centre/releases/new?tag=v$VERSION&title=Centre%20$VERSION&body=$NOTES_Q"
      open -R "$OUT/Centre-$VERSION.dmg"
      echo "Opened the GitHub release page and dist/: drag in both files, then Publish."
    fi
    exit 0 ;;
  install)
    quit_centre
    rm -rf "$DEST.new"
    if ! ditto "$APP" "$DEST.new" 2>/dev/null; then echo "Couldn't write to /Applications"; exit 1; fi
    codesign --verify --strict "$DEST.new" || { echo "The copy's signature didn't verify; nothing was replaced"; rm -rf "$DEST.new"; exit 1; }
    if [ -d "$DEST" ] && ! rm -rf "$DEST" 2>/dev/null; then
      rm -rf "$DEST.new"
      echo "macOS blocked replacing /Applications/Centre.app. Allow Centre under System Settings › Privacy & Security › App Management, then install again."
      open "$DEST"; exit 1
    fi
    mv "$DEST.new" "$DEST"
    [ -x "$LSREG" ] && "$LSREG" -f "$DEST" >/dev/null 2>&1 || true
    open "$DEST"
    echo "Installed Centre $VERSION (build $(defaults read "$DEST/Contents/Info" CFBundleVersion 2>/dev/null)) in /Applications"
    exit 0 ;;
esac

[ -n "$CENTRE_NO_LAUNCH" ] && exit 0   # in-app rebuild: the app relaunches itself
# From the agent, "build" never interrupts a running Centre: it switches to a new build of itself once its
# panel is closed, and the installed copy only changes with "install". "restart" relaunches right away.
if [ -n "$CENTRE_AGENT" ] && [ "$1" = "build" ] && { pgrep -f "$APPRE" >/dev/null || [ -d "$DEST" ]; }; then echo "Built; not launched"; exit 0; fi
quit_centre
open "$(run_app)"
echo "Centre is running — press ⌘ Space."
